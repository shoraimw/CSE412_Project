# Required in production: generate a unique random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-long-random-secret
# Optional comma-separated exact frontend origins. Same-origin requests need no CORS.
CORS_ORIGIN=
# Optional local API port.
PORT=3000
# The current demo uses in-memory repositories. Configure and migrate a dedicated
# persistent database before production use; never reuse another application's database.
